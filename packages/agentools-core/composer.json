{
  "name": "agentools/platform-core",
  "description": "Private pure values and ports for the additive AgenTools platform.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "AgenToolsPlatform\\Core\\": "src/"
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/vendor",
      "/phpstan.neon",
      "/composer.lock"
    ]
  },
  "scripts": {
    "test": [
      "@php tests/smoke.php",
      "@php tests/Common/run.php",
      "@php tests/Runtime/run.php",
      "@php tests/Models/run.php",
      "@php tests/Runtime/advance.php"
    ],
    "analyse": "phpstan analyse -c phpstan.neon --no-progress"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "platform": {
      "php": "8.3.0"
    }
  },
  "extra": {
    "agentools": {
      "private": true,
      "evidence_tier": "unit"
    }
  }
}
