{
  "name": "agentools/platform-laravel",
  "description": "Private opt-in Laravel host composition with scoped admission and durable Actions.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "agentools/platform-core": "dev-main",
    "agentools/platform-postgres": "dev-main",
    "agentools/sdk": "dev-main",
    "agentools/platform-model-adapter": "dev-main",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5",
    "laravel/octane": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "AgenToolsPlatform\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgenToolsPlatform\\Laravel\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/vendor",
      "/composer.lock",
      "/phpstan.neon"
    ]
  },
  "scripts": {
    "test": [
      "@php tests/Operations/contract.php",
      "python3 tests/Composition/composition.py"
    ],
    "analyse": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=512M"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "platform": {
      "php": "8.3.0"
    }
  },
  "extra": {
    "agentools": {
      "private": true,
      "evidence_tier": "contract-scripted",
      "framework_integration": "Laravel 12 explicit provider; no auto-discovery or routes"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../agentools-core",
      "options": {
        "symlink": false,
        "versions": {
          "agentools/platform-core": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../agentools-postgres",
      "options": {
        "symlink": false,
        "versions": {
          "agentools/platform-postgres": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../../php",
      "options": {
        "symlink": false,
        "versions": {
          "agentools/sdk": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../agentools-model-adapter",
      "options": {
        "symlink": false,
        "versions": {
          "agentools/platform-model-adapter": "dev-main"
        }
      }
    }
  ]
}
