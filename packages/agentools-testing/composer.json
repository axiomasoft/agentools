{
  "name": "agentools/platform-testing",
  "description": "Private development-only platform test reporting and architecture fixtures.",
  "type": "library",
  "license": "proprietary",
  "repositories": [{"type": "path", "url": "../agentools-core", "options": {"symlink": false, "versions": {"agentools/platform-core": "dev-main"}}}],
  "require": {"php": ">=8.3", "agentools/platform-core": "dev-main"},
  "require-dev": {"phpstan/phpstan": "^2.2"},
  "autoload": {"psr-4": {"AgenToolsPlatform\\Testing\\": "src/"}},
  "archive": {"exclude": ["/tests", "/fixtures", "/bin", "/vendor", "/phpstan.neon", "/composer.lock"]},
  "scripts": {
    "test": ["@php tests/smoke.php", "@php tests/run.php"],
    "analyse": "phpstan analyse -c phpstan.neon --no-progress"
  },
  "config": {"sort-packages": true, "allow-plugins": false, "platform": {"php": "8.3.0"}},
  "extra": {"agentools": {"private": true, "dev_only": true}}
}
