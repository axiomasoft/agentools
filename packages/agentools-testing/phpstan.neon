parameters:
    bootstrapFiles:
        - tests/bootstrap.php
        - tests/Journeys/bootstrap.php
        - ../../conformance/platform/second-host/bootstrap.php
    level: max
    paths:
        - src
        - tests
        - ../../examples/platform/read-journey/src
        - ../../examples/platform/support-host/src
    excludePaths:
        - tests/no-dev/vendor
    scanDirectories:
        - ../agentools-core/src
        - ../agentools-postgres/src
