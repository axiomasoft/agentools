{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentools.dev/bakeoff/p06-if-then-else/schema.json",
  "title": "Bakeoff p06 — if/then/else + dependentSchemas",
  "description": "Условные поля профиля инструмента: тип шага диктует обязательные поля (образец — Step.allOf в scenario.json), плюс dependentSchemas для approval, зависимого от side_effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind"],
  "properties": {
    "kind": { "type": "string", "enum": ["llm", "tool"] },
    "prompt_ref": { "type": "string" },
    "tool": { "type": "string" },
    "side_effect": { "type": "string", "enum": ["read", "write"] },
    "approval": { "type": "string", "enum": ["none", "confirm"] }
  },
  "if": {
    "properties": { "kind": { "const": "llm" } }
  },
  "then": {
    "required": ["prompt_ref"]
  },
  "else": {
    "required": ["tool"]
  },
  "dependentSchemas": {
    "side_effect": {
      "if": {
        "properties": { "side_effect": { "const": "write" } }
      },
      "then": {
        "required": ["approval"]
      }
    }
  }
}
