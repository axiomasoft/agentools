      "status": { "type": "string" },
      "assignee_id": { "type": "string" }
    },
    "required": ["task_id"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": { "type": "string" },
      "status": { "type": "string" }
    }
  },
  "annotations": {
