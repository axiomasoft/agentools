{
  "id": "scnlimit-006",
  "title": "Лимит длины выражения (512 кодовых точек) превышен длинным строковым литералом",
  "vector_class": "behavior",
  "spec_rev": "2026-09",
  "spec_rule_ids": [
    "SCN-17",
    "SCN-21",
    "SCN-22"
  ],
  "conformance_level": "L2",
  "given": {
    "tools": [
      {
        "name": "crm_task_update",
        "title": "Обновить задачу",
        "description": "Изменяет статус либо поля задачи CRM. Обратимая операционная запись: изменение устранимо повторным вызовом с прежними значениями.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "assignee_id": {
              "type": "string"
            }
          },
          "required": [
            "task_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "crm.task.write"
            ]
          }
        }
      }
    ],
    "scenario": {
      "scenario_id": "limit_probe",
      "title": "Выражение длиннее 512 кодовых точек Unicode (SCN-17); превышение — техническая ошибка (SCN-21), рантайм лимит не ослабляет (SCN-22).",
      "spec_rev": "2026-09",
      "steps": [
        {
          "id": "probe",
          "tool": "crm_task_update",
          "when": "$ctx.tenant == \"\"",
          "input_map": {
            "task_id": "$ctx.task_id"
          },
          "on_technical_fail": {
            "action": "abort"
          }
        }
      ]
    }
  },
  "script": [
    {
      "user_input": "Выполни шаг сценария по этому условию."
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "audit.limit_exceeded",
        "payload": {
          "limit_name": "expression.max_length"
        }
      },
      {
        "kind": "action_failed"
      }
    ],
    "final_state": "failed",
    "error": {
      "code": "agentools.budget.limit_exceeded"
    }
  }
}
