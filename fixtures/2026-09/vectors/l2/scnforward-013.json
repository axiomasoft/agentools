{
  "id": "scnforward-013",
  "title": "Та же ссылка на результат допустима, когда её шаг уже расположен раньше",
  "vector_class": "behavior",
  "spec_rev": "2026-09",
  "spec_rule_ids": ["SCN-3", "SCN-9"],
  "conformance_level": "L2",
  "given": {
    "tools": [
      {
        "name": "demo_probe",
        "description": "Purpose: Проверяет детерминированный сценарный вызов без побочного эффекта.\nCall when: Нужен безопасный probe для проверки исполнения сценария.\nRequired arguments: value\nExample: demo_probe({\"value\":\"probe\"})",
        "inputSchema": {"type": "object", "properties": {"value": {}}},
        "outputSchema": {"type": "object", "properties": {"value": {}}},
        "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
        "_meta": {"dev.agentools/action": {"side_effect": "read", "confirmation": "none", "permissions_hint": ["demo.read"]}}
      }
    ],
    "scenario": {
      "scenario_id": "forward_reference_rejected",
      "title": "Первый в перечне шаг даёт результат для следующего",
      "spec_rev": "2026-09",
      "steps": [
        {"id": "second", "tool": "demo_probe", "input_map": {"value": "second"}},
        {"id": "first", "tool": "demo_probe", "input_map": {"value": "$steps.second.value"}}
      ]
    }
  },
  "script": [{"user_input": "Выполни сценарий с ссылкой на уже завершённый шаг."}],
  "expect": {
    "events": [
      {"kind": "scenario_started", "payload": {"scenario_id": "forward_reference_rejected"}},
      {"kind": "step_started", "payload": {"step_id": "second"}},
      {"kind": "step_started", "payload": {"step_id": "first"}},
      {"kind": "scenario_completed", "payload": {"scenario_id": "forward_reference_rejected", "outcome": "COMPLETED"}}
    ],
    "final_state": "completed"
  }
}
