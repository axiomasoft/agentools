{
  "id": "confpolicy-107",
  "title": "Commit с сохранённым разрешением исполняет подтверждённый вызов",
  "vector_class": "behavior",
  "spec_rev": "2026-09",
  "spec_rule_ids": [
    "CNF-35"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "demo_probe",
        "description": "Purpose: Записывает проверяемое значение.\nCall when: Нужно проверить подтверждённое изменение.\nRequired arguments: value.\nExample: demo_probe({\"value\":\"x\"})",
        "inputSchema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            }
          }
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "demo.write"
            ]
          }
        }
      }
    ],
    "policy": {
      "allowed_tools": [
        "demo_probe"
      ],
      "rules": [
        {
          "scope": "tool",
          "verdict": "ask"
        }
      ]
    },
    "driver_state": {
      "principals": {
        "initiator": {
          "id": "user-a"
        },
        "agent": {
          "id": "agent-a"
        },
        "authorizer": {
          "id": "user-a"
        }
      },
      "authorization": {
        "resource": "record-1",
        "tool": "demo_probe",
        "permissions": [
          "demo.write"
        ]
      },
      "confirmation": {
        "proposal_id": "proposal-1",
        "proposal_version": 1,
        "token_id": "token-1",
        "covered_principal_id": "user-a",
        "prepared_descriptor_digest": "sha-256:descriptor-1",
        "current_descriptor_digest": "sha-256:descriptor-1",
        "prepared_args_fingerprint": "sha-256:args-1",
        "commit_args_fingerprint": "sha-256:args-1"
      }
    }
  },
  "script": [
    {
      "user_input": "Измени запись"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "demo_probe",
          "args": {
            "value": "policy"
          }
        }
      }
