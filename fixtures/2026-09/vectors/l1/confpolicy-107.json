      {
        "kind": "confirmation_resolved",
        "payload": {
          "authorization_resource": "record-1"
        }
      },
      {
        "kind": "action_completed"
      }
    ],
    "final_state": "completed",
    "tool_calls": [
      {
        "tool": "demo_probe",
        "args_subset": {
          "value": "policy"
        },
        "phase": "commit"
      }
    ]
  }
