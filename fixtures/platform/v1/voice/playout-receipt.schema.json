{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:v1:voice:playout-receipt",
  "title": "Authenticated playout fact; unknown is a separate checkpoint state",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_ref", "response_ref", "response_version", "segment_ref", "attempt_ref", "media_epoch", "delivered_offset", "offset_unit", "status", "evidence_level"],
  "properties": {
    "receipt_ref": {"$ref": "#/$defs/ref"},
    "response_ref": {"$ref": "#/$defs/ref"},
    "response_version": {"$ref": "#/$defs/version"},
    "segment_ref": {"$ref": "#/$defs/ref"},
    "attempt_ref": {"$ref": "#/$defs/ref"},
    "media_epoch": {"$ref": "#/$defs/version"},
    "delivered_offset": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "offset_unit": {"const": "utf8_bytes"},
    "status": {"enum": ["completed", "interrupted", "failed"]},
    "evidence_level": {"enum": ["server_estimate", "client_ack"]}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "ref": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "kind", "id"],
      "properties": {"tenant_id": {"$ref": "#/$defs/id"}, "kind": {"const": "ref"}, "id": {"$ref": "#/$defs/id"}}}
  }
}
