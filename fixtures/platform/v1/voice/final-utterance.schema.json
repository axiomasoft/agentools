{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:v1:voice:final-utterance",
  "title": "Host-normalized final utterance, not a browser authorization envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "realtime_session_ref", "media_epoch", "utterance_id", "revision", "locale", "started_at", "ended_at", "text_ref", "text_hash", "context_revision", "idempotency_key", "is_final", "channel"],
  "properties": {
    "event_id": {"$ref": "#/$defs/id"},
    "realtime_session_ref": {"$ref": "#/$defs/ref"},
    "media_epoch": {"$ref": "#/$defs/version"},
    "utterance_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/version"},
    "locale": {"type": "string", "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*$"},
    "started_at": {"$ref": "#/$defs/instant"},
    "ended_at": {"$ref": "#/$defs/instant"},
    "text_ref": {"$ref": "#/$defs/ref"},
    "text_hash": {"type": "string", "pattern": "^sha-256:[a-f0-9]{64}$"},
    "context_revision": {"$ref": "#/$defs/version"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "is_final": {"const": true},
    "channel": {"enum": ["voice", "text-fallback"]}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"},
    "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "instant": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_id", "kind", "id"],
      "properties": {"tenant_id": {"$ref": "#/$defs/id"}, "kind": {"const": "ref"}, "id": {"$ref": "#/$defs/id"}}
    }
  }
}
