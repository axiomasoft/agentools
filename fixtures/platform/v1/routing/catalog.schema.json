{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:routing:catalog:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tenant",
    "id",
    "provider",
    "account",
    "region",
    "model_revision",
    "credential_ref",
    "snapshot_ref",
    "endpoint",
    "context_limit",
    "output_limit",
    "data_classes",
    "terms",
    "model_evidence",
    "capabilities",
    "quality",
    "latency_ms",
    "cost_minor",
    "pricing_version",
    "pricing_evidence"
  ],
  "properties": {
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "deployment-catalog/v1"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^https://[^@?#]+$"
    },
    "context_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "output_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terms": {
      "$ref": "#/$defs/evidence"
    },
    "model_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "text",
          "references",
          "vision",
          "audio",
          "tools",
          "structured_output",
          "streaming",
          "cache",
          "continuation",
          "provider_options"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/evidence"
      }
    },
    "quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cost_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pricing_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "pricing_evidence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/evidence"
        }
      ]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "evidence",
        "checked_at",
        "expires_at",
        "evidence_ref"
      ],
      "properties": {
        "support": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "evidence": {
          "enum": [
            "unverified",
            "documented",
            "probe_verified"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pricing_version": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "pricing_evidence": {
            "type": "null"
          },
          "cost_minor": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "pricing_evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  ]
}
