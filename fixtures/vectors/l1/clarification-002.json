{
  "id": "clarification-002",
  "title": "Уточнение declined без фолбэка (нет default в сценарии шага) → трактуется как cancelled → CANCELLED",
  "spec_refs": [
    "CP-27",
    "LC-T11"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_report_list",
        "title": "Список отчётов о работе",
        "description": "Возвращает страницу отчётов сотрудника за период. Только чтение.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string"
            },
            "response_format": {
              "type": "string",
              "enum": [
                "concise",
                "detailed"
              ]
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array"
            },
            "next_cursor": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "read",
            "permissions_hint": [
              "crm.report.read"
            ]
          }
        }
      }
    ]
  },
  "script": [
    {
      "user_input": "Запиши звонок с Ивановым"
    },
    {
      "llm_stub": {
        "structured": {
          "clarification": {
            "id": "clr_pick_contact_no_default",
            "question": "Какой из контактов Иванов имеется в виду?",
            "kind": "select",
            "options": [
              {
                "value": "contact_101",
                "title": "Иванов Иван Иванович (ООО «Ромашка»)"
              },
              {
                "value": "contact_102",
                "title": "Иванов Пётр Сергеевич (ИП Иванов)"
              },
              {
                "value": "contact_103",
                "title": "Иванова Мария Олеговна (АО «Спектр»)"
              }
            ]
          }
        }
      }
    },
    {
      "clarification_answer": {
        "id": "clr_pick_contact_no_default",
        "status": "declined"
      }
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "state_changed",
        "payload": {
          "from": "RUNNING",
          "to": "WAITING_INPUT",
          "trigger": "clarification_requested"
        }
      },
      {
        "kind": "clarification_answered",
        "payload": {
          "clarification_id": "clr_pick_contact_no_default",
          "status": "declined"
        }
      },
      {
        "kind": "session_cancelled"
      }
    ],
    "final_state": "CANCELLED"
  }
}
