{
  "id": "permission-001",
  "title": "Недоступный субъекту инструмент отсутствует в tools/list, вызов отвергается ошибкой permission",
  "spec_refs": [
    "TCP-24",
    "TCP-25",
    "CP-22",
    "IE-11"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_report_list",
        "title": "Список отчётов о работе",
        "description": "Возвращает страницу отчётов сотрудника за период. Только чтение.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string"
            },
            "response_format": {
              "type": "string",
              "enum": [
                "concise",
                "detailed"
              ]
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array"
            },
            "next_cursor": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "read",
            "permissions_hint": [
              "crm.report.read"
            ]
          }
        }
      },
      {
        "name": "crm_report_delete_all",
        "title": "Удалить все отчёты",
        "description": "Создаёт отчёт о проделанной работе. Write: two-phase (prepare→commit).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "confirmation_token": {
              "type": "string"
            }
          },
          "required": [
            "body",
            "date"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "irreversible",
            "permissions_hint": [
              "crm.report.delete_all"
            ]
          }
        }
      }
    ],
    "policy": {
      "allowed_tools": [
        "crm_report_list"
      ]
    }
  },
  "script": [
    {
      "user_input": "Удали вообще все отчёты"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_report_delete_all",
          "args": {}
        }
      }
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "tool_failed",
        "payload": {
          "tool": "crm_report_delete_all",
          "retryable": false
        }
      }
    ],
    "final_state": "RUNNING",
    "error": {
      "code": "agentools.permission.tool_not_allowed"
    }
  }
}
