{
  "id": "idempotency-002",
  "title": "Commit-вызов с ключом, у которого запись дедупликации уже в статусе in_flight, → conflict без переисполнения",
  "spec_refs": [
    "IE-6",
    "IE-11",
    "IE-14",
    "LC-T15",
    "AU-12"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_report_create",
        "title": "Отправить отчёт о работе",
        "description": "Создаёт отчёт о проделанной работе. Write: two-phase (prepare→commit).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "confirmation_token": {
              "type": "string"
            }
          },
          "required": [
            "body",
            "date"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "crm.report.create"
            ]
          }
        }
      }
    ],
    "preseed": {
      "idempotency": [
        {
          "tool": "crm_report_create",
          "status": "in_flight"
        }
      ]
    }
  },
  "script": [
    {
      "user_input": "Отправь отчёт за сегодня: закрыл 3 сделки"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_report_create",
          "args": {
            "body": "Сегодня закрыл 3 сделки и согласовал бюджет на квартал.",
            "date": "2026-07-10"
          }
        }
      }
    },
    {
      "approval": "accept"
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "tool_prepared",
        "payload": {
          "tool": "crm_report_create"
        }
      },
      {
        "kind": "tool_failed",
        "payload": {
          "tool": "crm_report_create",
          "retryable": true
        }
      },
      {
        "kind": "state_changed",
        "payload": {
          "from": "EXECUTING_TOOL",
          "to": "FAILED_RETRYABLE",
          "trigger": "failed_retryable"
        }
      }
    ],
    "final_state": "FAILED_RETRYABLE",
    "tool_calls": [
      {
        "tool": "crm_report_create",
        "args_subset": {
          "date": "2026-07-10"
        },
        "phase": "prepare"
      }
    ],
    "error": {
      "code": "agentools.conflict.in_flight_duplicate"
    }
  }
}
