{
  "id": "lifecycle-001",
  "title": "Happy-path вызова read-инструмента (однофазный, без гейта)",
  "spec_refs": [
    "LC-T5",
    "LC-T14",
    "TCP-20"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_report_list",
        "title": "Список отчётов о работе",
        "description": "Возвращает страницу отчётов сотрудника за период. Только чтение.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string"
            },
            "response_format": {
              "type": "string",
              "enum": [
                "concise",
                "detailed"
              ]
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array"
            },
            "next_cursor": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "read",
            "permissions_hint": [
              "crm.report.read"
            ]
          }
        }
      }
    ]
  },
  "script": [
    {
      "user_input": "Покажи мои отчёты за июль"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_report_list",
          "args": {
            "period": "2026-07"
          }
        }
      }
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "state_changed",
        "payload": {
          "from": "RUNNING",
          "to": "EXECUTING_TOOL",
          "trigger": "tool_invoked"
        }
      },
      {
        "kind": "state_changed",
        "payload": {
          "from": "EXECUTING_TOOL",
          "to": "RUNNING",
          "trigger": "tool_succeeded"
        }
      }
    ],
    "final_state": "RUNNING"
  }
}
