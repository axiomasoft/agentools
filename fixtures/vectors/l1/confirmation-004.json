{
  "id": "confirmation-004",
  "title": "Edit = decline текущего действия + новый prepare с исправленными аргументами (CP-15)",
  "spec_refs": [
    "CP-15",
    "LC-T19",
    "LC-T5",
    "LC-T13"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_report_create",
        "title": "Отправить отчёт о работе",
        "description": "Создаёт отчёт о проделанной работе. Write: two-phase (prepare→commit).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "confirmation_token": {
              "type": "string"
            }
          },
          "required": [
            "body",
            "date"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "crm.report.create"
            ]
          }
        }
      }
    ]
  },
  "script": [
    {
      "user_input": "Отправь отчёт за вчера: закрыл 3 сделки"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_report_create",
          "args": {
            "body": "Закрыл 3 сделки",
            "date": "2026-07-09"
          }
        }
      }
    },
    {
      "approval": "decline"
    },
    {
      "user_input": "Нет, это было сегодня, а не вчера"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_report_create",
          "args": {
            "body": "Закрыл 3 сделки",
            "date": "2026-07-10"
          }
        }
      }
    },
    {
      "approval": "accept"
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "tool_prepared",
        "payload": {
          "tool": "crm_report_create"
        }
      },
      {
        "kind": "approval_resolved",
        "payload": {
          "decision": "decline"
        }
      },
      {
        "kind": "state_changed",
        "payload": {
          "from": "WAITING_APPROVAL",
          "to": "RUNNING",
          "trigger": "approval_declined"
        }
      },
      {
        "kind": "state_changed",
        "payload": {
          "from": "RUNNING",
          "to": "EXECUTING_TOOL",
          "trigger": "tool_invoked"
        }
      },
      {
        "kind": "tool_prepared",
        "payload": {
          "tool": "crm_report_create"
        }
      },
      {
        "kind": "approval_resolved",
        "payload": {
          "decision": "accept"
        }
      },
      {
        "kind": "tool_committed",
        "payload": {
          "tool": "crm_report_create"
        }
      }
    ],
    "final_state": "RUNNING",
    "tool_calls": [
      {
        "tool": "crm_report_create",
        "args_subset": {
          "date": "2026-07-09"
        },
        "phase": "prepare"
      },
      {
        "tool": "crm_report_create",
        "args_subset": {
          "date": "2026-07-10"
        },
        "phase": "prepare"
      },
      {
        "tool": "crm_report_create",
        "args_subset": {
          "date": "2026-07-10"
        },
        "phase": "commit"
      }
    ]
  }
}
