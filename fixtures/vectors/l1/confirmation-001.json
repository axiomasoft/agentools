{
  "id": "confirmation-001",
  "title": "Write-инструмент: prepare → accept → commit (happy path)",
  "spec_refs": [
    "CP-2",
    "CP-3",
    "LC-T13",
    "LC-T18",
    "LC-T14",
    "AU-9",
    "AU-10",
    "AU-11"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_report_create",
        "title": "Отправить отчёт о работе",
        "description": "Создаёт отчёт о проделанной работе. Write: two-phase (prepare→commit).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "confirmation_token": {
              "type": "string"
            }
          },
          "required": [
            "body",
            "date"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "agentools/v1": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "crm.report.create"
            ]
          }
        }
      }
    ]
  },
  "script": [
    {
      "user_input": "Отправь отчёт за сегодня: закрыл 3 сделки и согласовал бюджет"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_report_create",
          "args": {
            "body": "Сегодня закрыл 3 сделки и согласовал бюджет на квартал.",
            "date": "2026-07-10"
          }
        }
      }
    },
    {
      "approval": "accept"
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "state_changed",
        "payload": {
          "from": "EXECUTING_TOOL",
          "to": "WAITING_APPROVAL",
          "trigger": "approval_required"
        }
      },
      {
        "kind": "tool_prepared",
        "payload": {
          "tool": "crm_report_create"
        }
      },
      {
        "kind": "approval_requested",
        "payload": {
          "tool": "crm_report_create"
        }
      },
      {
        "kind": "approval_resolved",
        "payload": {
          "decision": "accept"
        }
      },
      {
        "kind": "state_changed",
        "payload": {
          "from": "WAITING_APPROVAL",
          "to": "EXECUTING_TOOL",
          "trigger": "approval_granted"
        }
      },
      {
        "kind": "tool_committed",
        "payload": {
          "tool": "crm_report_create"
        }
      },
      {
        "kind": "state_changed",
        "payload": {
          "from": "EXECUTING_TOOL",
          "to": "RUNNING",
          "trigger": "tool_succeeded"
        }
      }
    ],
    "final_state": "RUNNING",
    "tool_calls": [
      {
        "tool": "crm_report_create",
        "args_subset": {
          "date": "2026-07-10"
        },
        "phase": "prepare"
      },
      {
        "tool": "crm_report_create",
        "args_subset": {
          "date": "2026-07-10"
        },
        "phase": "commit"
      }
    ]
  }
}
