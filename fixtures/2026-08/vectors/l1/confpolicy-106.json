    "observations": [
      {
        "kind": "tool_boundary",
        "probe_id": "cnf_8_tool_spy",
        "tool": "demo_probe",
        "phase": "commit",
        "calls": 1,
        "route": "default",
        "args_subset": {
          "value": "policy"
        },
        "actor_ids": [
          "user-a",
