        "demo_probe"
      ],
      "rules": [
        {
          "scope": "user",
          "verdict": "ask"
        }
      ]
    },
    "driver_state": {
      "principals": {
        "initiator": {
          "id": "user-a"
        },
        "agent": {
          "id": "agent-a"
        },
        "authorizer": {
          "id": "user-a"
        }
      },
      "authorization": {
        "resource": "record-1",
        "tool": "demo_probe",
        "permissions": [
          "demo.write"
        ]
      }
    }
  },
  "script": [
    {
      "user_input": "Измени запись"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "demo_probe",
          "args": {
            "value": "policy"
          }
        }
      }
    },
    {
      "approval": "approve"
    }
