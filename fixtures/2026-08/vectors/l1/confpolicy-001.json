{
  "id": "confpolicy-001",
  "title": "Политика сводится по deny-overrides, не ослабляет эффект и повторно авторизует commit",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": ["TLP-11", "CNF-3", "CNF-4", "CNF-5", "CNF-6", "CNF-8", "CNF-35", "CNF-36"],
  "conformance_level": "L1",
  "given": {
    "tools": [{
      "name": "agentools_probe",
      "title": "Проверочный инструмент",
      "description": "Записывает значение после подтверждения.",
      "inputSchema": {"type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]},
      "outputSchema": {"type": "object", "properties": {"accepted": {"type": "boolean"}}},
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "_meta": {"dev.agentools/action": {"side_effect": "write", "confirmation": "confirm", "idempotent_commit": true, "permissions_hint": ["agentools.probe"]}}
    }]
  },
  "script": [
    {"user_input": "Запиши значение после policy-гейта"},
    {"llm_stub": {"toolCall": {"tool": "agentools_probe", "args": {"value": "policy"}}}},
    {"approval": "approve"}
  ],
  "expect": {
    "events": [
      {"kind": "confirmation_requested", "payload": {"policy_verdict": "require_confirmation", "resolution": "deny_overrides", "scope_order": ["environment", "tenant", "user"], "gate_origin": "side_effect", "prepare_authorized": true}},
      {"kind": "confirmation_resolved", "payload": {"commit_authorized_independently": true, "proposal_is_not_authorization": true}}
    ],
    "final_state": "completed",
    "tool_calls": [{"tool": "agentools_probe", "args_subset": {"value": "policy"}, "phase": "commit"}]
  }
}
