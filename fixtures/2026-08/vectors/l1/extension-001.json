{
  "id": "extension-001",
  "title": "Посторонний вендорный `_meta`-ключ рядом с dev.agentools/action не является данными AgenTools и не влияет на гейт",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": [
    "EXT-7",
    "EXT-10"
  ],
  "conformance_level": "L1",
  "given": {
    "tools": [
      {
        "name": "crm_task_update_foreignmeta",
        "title": "Обновить задачу",
        "description": "Изменяет статус либо поля задачи CRM. Обратимая операционная запись: изменение устранимо повторным вызовом с прежними значениями.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "assignee_id": {
              "type": "string"
            }
          },
          "required": [
            "task_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "crm.task.write"
            ]
          },
          "acme.crm/legacy-profile": {
            "side_effect": "read",
            "note": "Чужой вендорный ключ, структурно похожий на профиль AgenTools, но данными AgenTools не являющийся (EXT-10). Значение side_effect=read здесь нарочно противоречит настоящему профилю: реализация, ошибочно подобравшая класс эффекта из этого ключа, пропустила бы гейт."
          }
        }
      }
    ]
  },
  "script": [
    {
      "user_input": "Переведи задачу T-700 в статус done"
    },
    {
      "llm_stub": {
        "toolCall": {
          "tool": "crm_task_update_foreignmeta",
          "args": {
            "task_id": "T-700",
            "status": "done"
          }
        }
      }
    },
    {
      "approval": "approve"
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "confirmation_requested"
      },
      {
        "kind": "confirmation_resolved",
        "payload": {
          "decision": "approve"
        }
      },
      {
        "kind": "effect_requested"
      },
      {
        "kind": "effect_confirmed"
      },
      {
        "kind": "action_completed"
      }
    ],
    "final_state": "completed",
    "tool_calls": [
      {
        "tool": "crm_task_update_foreignmeta",
        "args_subset": {
          "task_id": "T-700",
          "status": "done"
        },
        "phase": "prepare"
      },
      {
        "tool": "crm_task_update_foreignmeta",
        "phase": "commit"
      }
    ]
  }
}
