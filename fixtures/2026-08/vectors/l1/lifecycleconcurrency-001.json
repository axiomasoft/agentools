  "expect": {
    "events": [
      {"kind": "effect_requested", "payload": {"step_name": "agentools_probe:commit", "effect_id": "agentools_probe:concurrent", "expected_prev_seq": 4, "epoch": 2, "registry_reread": true}},
      {"kind": "effect_confirmed", "payload": {"epoch": 2}}
    ],
    "final_state": "completed",
    "tool_calls": [{"tool": "agentools_probe", "args_subset": {"value": "concurrent"}, "phase": "commit"}]
  }
