{
  "id": "conftoken-001",
  "title": "Commit перепроверяет principal, descriptor digest и hashes токена без повторного вывода гейта",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": ["CNF-13", "CNF-21", "CNF-23", "CNF-38"],
  "conformance_level": "L1",
  "given": {
    "tools": [{
      "name": "agentools_probe",
      "title": "Проверочный инструмент",
      "description": "Записывает значение после проверки токена.",
      "inputSchema": {"type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]},
      "outputSchema": {"type": "object", "properties": {"accepted": {"type": "boolean"}}},
      "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "_meta": {"dev.agentools/action": {"side_effect": "write", "confirmation": "confirm", "idempotent_commit": true, "permissions_hint": ["agentools.probe"]}}
    }]
  },
  "script": [
    {"user_input": "Подготовь изменение"},
    {"llm_stub": {"toolCall": {"tool": "agentools_probe", "args": {"value": "token"}}}},
    {"approval": "approve"}
  ],
  "expect": {
    "events": [{"kind": "confirmation_resolved", "payload": {"principal_matches": true, "descriptor_digest_matches": true, "args_hash_at_decision": "sha256:args", "args_hash_at_commit": "sha256:args", "gate_rederived": false}}],
    "final_state": "completed",
    "tool_calls": [{"tool": "agentools_probe", "args_subset": {"value": "token"}, "phase": "commit"}]
  }
}
