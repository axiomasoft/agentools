{
  "id": "scncomp-010",
  "title": "Компенсация успешно завершённого шага после технического отказа последующего — обратный порядок, исход COMPENSATED",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": [
    "SCN-23",
    "SCN-24",
    "SCN-25",
    "SCN-28"
  ],
  "conformance_level": "L2",
  "given": {
    "tools": [
      {
        "name": "fina_funds_reserve",
        "title": "Зарезервировать средства",
        "description": "Резервирует средства на счёте под предстоящий платёж.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "amount_minor": {
              "type": "integer"
            },
            "reservation_id": {
              "type": "string"
            }
          },
          "required": [
            "account_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "reservation_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "fina.funds.write"
            ]
          }
        }
      },
      {
        "name": "fina_funds_release",
        "title": "Освободить резерв средств",
        "description": "Отменяет ранее сделанный резерв средств.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "amount_minor": {
              "type": "integer"
            },
            "reservation_id": {
              "type": "string"
            }
          },
          "required": [
            "account_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "reservation_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "fina.funds.write"
            ]
          }
        }
      },
      {
        "name": "fina_payment_send",
        "title": "Отправить платёж",
        "description": "Отправляет платёжное поручение во внешнюю систему. Необратимое действие.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "counterparty_id": {
              "type": "string"
            },
            "amount_minor": {
              "type": "integer"
            },
            "purpose": {
              "type": "string"
            }
          },
          "required": [
            "counterparty_id",
            "amount_minor",
            "purpose"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "payment_id": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "irreversible",
            "confirmation": "double_confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "fina.payment.send"
            ]
          }
        }
      }
    ],
    "scenario": {
      "scenario_id": "payment_send_compensated",
      "title": "Резерв средств откатывается, когда отправка платежа технически не удалась",
      "spec_rev": "2026-08",
      "steps": [
        {
          "id": "reserve",
          "tool": "fina_funds_reserve",
          "input_map": {
            "account_id": "$ctx.account_id",
            "amount_minor": "$ctx.amount_minor"
          },
          "compensate": {
            "tool": "fina_funds_release",
            "input_map": {
              "reservation_id": "$steps.reserve.reservation_id"
            }
          }
        },
        {
          "id": "send",
          "tool": "fina_payment_send",
          "input_map": {
            "counterparty_id": "$ctx.counterparty_id",
            "amount_minor": "$steps.reserve.amount_minor",
            "purpose": "$ctx.absent_purpose_field"
          },
          "on_technical_fail": {
            "action": "abort"
          }
        }
      ]
    }
  },
  "script": [
    {
      "user_input": "Зарезервируй сумму и отправь платёж по сценарию."
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "action_completed"
      },
      {
        "kind": "action_failed"
      },
      {
        "kind": "audit.compensation_executed",
        "payload": {
          "scenario_id": "payment_send_compensated",
          "step_id": "reserve"
        }
      },
      {
        "kind": "audit.scenario_run_finished",
        "payload": {
          "scenario_id": "payment_send_compensated",
          "outcome": "COMPENSATED"
        }
      }
    ],
    "final_state": "failed"
  }
}
