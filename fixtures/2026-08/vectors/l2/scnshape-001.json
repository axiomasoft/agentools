{
  "id": "scnshape-001",
  "title": "Сценарий как данные: порядок по позиции, свой журнал на шаг, адресация по id, ревизия в теле",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": [
    "SCN-1",
    "SCN-2",
    "SCN-3",
    "SCN-5"
  ],
  "conformance_level": "L2",
  "given": {
    "tools": [
      {
        "name": "crm_report_list",
        "title": "Список отчётов о работе",
        "description": "Purpose: Возвращает страницу отчётов сотрудника за период.\nCall when: Пользователю нужен список отчётов без изменения данных.\nRequired arguments: period\nExample: crm_report_list({\"period\":\"2026-07\"})",
        "inputSchema": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string"
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array"
            },
            "next_cursor": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "read",
            "permissions_hint": [
              "crm.report.read"
            ]
          }
        }
      },
      {
        "name": "crm_report_draft_save",
        "title": "Сохранить черновик отчёта",
        "description": "Сохраняет черновик отчёта о работе без публикации: виден только автору, внешнего следствия не порождает.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string"
            },
            "draft_version": {
              "type": "integer"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "draft",
            "permissions_hint": [
              "crm.report.write"
            ]
          }
        }
      }
    ],
    "scenario": {
      "scenario_id": "crm_report_intake",
      "title": "Список отчётов, затем сохранение черновика по его результату",
      "spec_rev": "2026-08",
      "steps": [
        {
          "id": "list",
          "tool": "crm_report_list",
          "input_map": {
            "period": "$ctx.period"
          }
        },
        {
          "id": "save",
          "tool": "crm_report_draft_save",
          "input_map": {
            "text": "$steps.list.items"
          }
        }
      ]
    }
  },
  "script": [
    {
      "user_input": "Возьми последний список отчётов и сохрани его как черновик."
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "action_created",
        "payload": {}
      },
      {
        "kind": "action_completed"
      },
      {
        "kind": "action_created",
        "payload": {}
      },
      {
        "kind": "action_completed"
      }
    ],
    "final_state": "completed",
    "tool_calls": [
      {
        "tool": "crm_report_list",
        "phase": "commit"
      },
      {
        "tool": "crm_report_draft_save",
        "phase": "commit"
      }
    ]
  }
}
