{
  "id": "scnorder-002",
  "title": "Ссылка на шаг, идущий позже в перечне, отвергается статически — граф сценария есть цепочка, не граф с циклами",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": [
    "SCN-9"
  ],
  "conformance_level": "L2",
  "given": {
    "tools": [
      {
        "name": "crm_task_update",
        "title": "Обновить задачу",
        "description": "Изменяет статус либо поля задачи CRM. Обратимая операционная запись: изменение устранимо повторным вызовом с прежними значениями.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "assignee_id": {
              "type": "string"
            }
          },
          "required": [
            "task_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "_meta": {
          "dev.agentools/action": {
            "side_effect": "write",
            "confirmation": "confirm",
            "idempotent_commit": true,
            "permissions_hint": [
              "crm.task.write"
            ]
          }
        }
      }
    ],
    "scenario": {
      "scenario_id": "forward_reference_rejected",
      "title": "Первый шаг читает результат второго — второй в перечне идёт позже первого",
      "spec_rev": "2026-08",
      "steps": [
        {
          "id": "first",
          "tool": "crm_task_update",
          "input_map": {
            "task_id": "$ctx.task_id",
            "status": "$steps.second.status"
          }
        },
        {
          "id": "second",
          "tool": "crm_task_update",
          "input_map": {
            "task_id": "$ctx.task_id",
            "status": "done"
          }
        }
      ]
    }
  },
  "script": [
    {
      "user_input": "Обнови задачу по этому сценарию."
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "action_failed"
      }
    ],
    "final_state": "failed"
  }
}
