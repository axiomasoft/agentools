          "args": {
            "value": "scenario-002"
          }
        }
      }
    }
  ],
  "expect": {
    "events": [
      {
        "kind": "step_failed",
        "payload": {
          "step_id": "probe",
          "failure_class": "technical",
          "attempts": 3
        }
      },
      {
