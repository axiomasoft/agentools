    ],
    "scenario": {
      "scenario_id": "failure_routes",
      "title": "Сценарий failure_routes",
      "spec_rev": "2026-08",
      "steps": [
        {
          "id": "probe",
          "tool": "demo_probe",
          "on_technical_fail": {
            "action": "retry",
            "attempts": 2
          },
          "on_semantic_fail": {
            "action": "continue"
          }
        },
        {
          "id": "after",
          "tool": "demo_probe",
          "when": "missing($steps.probe.value)"
        }
      ]
    }
  },
  "script": [
    {
      "user_input": "Технический retry исчерпывается в abort, semantic continue оставляет результат отсутствующим"
