{
  "id": "lifecycleintegrity-001",
  "title": "Апкаст, immutable-журнал, снапшот и hash-chain проверяются независимо от idempotency key",
  "vector_class": "behavior",
  "spec_rev": "2026-08",
  "spec_rule_ids": ["ALC-28", "ALC-30", "ALC-31", "ALC-33", "ALC-34", "ALC-35", "ALC-36", "ALC-37"],
  "conformance_level": "L3",
  "given": {
    "tools": [{
      "name": "agentools_probe",
      "title": "Проверочный инструмент",
      "description": "Читает журнал с проверкой целостности.",
      "inputSchema": {"type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]},
      "outputSchema": {"type": "object", "properties": {"accepted": {"type": "boolean"}}},
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "_meta": {"dev.agentools/action": {"side_effect": "read", "permissions_hint": ["agentools.probe"]}}
    }]
  },
  "script": [
    {"user_input": "Проверь журнал и снапшот"},
    {"llm_stub": {"toolCall": {"tool": "agentools_probe", "args": {"value": "integrity"}, "meta": {"idempotency_key": "at1:integrity001"}}}}
  ],
  "expect": {
    "events": [
      {"kind": "action_created", "event_version": 1, "seq": 1, "prev_hash": null, "payload": {"upcast_chain": [1], "snapshot": {"seq": 0, "spec_rev": "2026-08", "source_of_truth": false}}},
      {"kind": "action_completed", "seq": 2, "prev_hash": "sha256:event-1", "payload": {"hash_input_excludes": ["prev_hash"], "chain_recomputed_from_seq": 1, "epoch_distinct_from_idempotency_key": true}}
    ],
    "final_state": "completed",
    "tool_calls": [{"tool": "agentools_probe", "args_subset": {"value": "integrity"}, "phase": "prepare"}]
  }
}
