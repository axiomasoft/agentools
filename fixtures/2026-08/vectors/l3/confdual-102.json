          "id": "user-a"
        },
        "agent": {
          "id": "agent-a"
        },
        "authorizer": {
          "id": "user-b"
        }
      },
      "authorization": {
        "resource": "payment-1",
        "tool": "demo_probe",
        "permissions": [
          "demo.write"
        ]
      }
    }
  },
  "script": [
    {
      "user_input": "Отправь платёж"
    },
    {
