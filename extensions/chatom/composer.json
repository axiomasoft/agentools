{
  "name": "agentools/platform-chatom-bridge",
  "description": "Private optional delivery and bounded history seam over existing AgenTools owners.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "agentools/platform-core": "dev-main",
    "agentools/platform-postgres": "dev-main",
    "agentools/sdk": "dev-main"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2"
  },
  "suggest": {
    "agentools/platform-chatom": "Existing NativeHistory and TextComposition integration; real Chatom driver/pin qualification remains host-owned."
  },
  "autoload": {
    "psr-4": {
      "AgenToolsPlatform\\ChatomBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgenToolsPlatform\\ChatomBridge\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/vendor",
      "/composer.lock",
      "/phpstan.neon"
    ]
  },
  "scripts": {
    "test": "python3 -B tests/run.py",
    "analyse": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=512M"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/agentools-core",
      "options": {
        "symlink": true,
        "versions": {
          "agentools/platform-core": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../../packages/agentools-postgres",
      "options": {
        "symlink": true,
        "versions": {
          "agentools/platform-postgres": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../../php",
      "options": {
        "symlink": true,
        "versions": {
          "agentools/sdk": "dev-main"
        }
      }
    }
  ],
  "extra": {
    "agentools": {
      "private": true,
      "registration": "Explicit host injection only; no auto-discovery, routes, default owners or parallel runtime loop"
    }
  }
}
