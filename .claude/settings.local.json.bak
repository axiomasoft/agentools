{
  "extraKnownMarketplaces": {
    "swissknifeman": {
      "source": {
        "source": "directory",
        "path": "/home/vostrikov/projects/packages/swissknifeman"
      }
    }
  },
  "enabledPlugins": {
    "core@swissknifeman": true,
    "mobile@swissknifeman": true,
    "php-packages@swissknifeman": true,
    "python@swissknifeman": false,
    "task@swissknifeman": true,
    "general@swissknifeman": false,
    "oss-dev@swissknifeman": false,
    "dart@swissknifeman": true
  },
  "permissions": {
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(chmod -R *)",
      "Bash(chown *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/*.key)",
      "Read(~/.claude/logs/**)",
      "Read(**/CHANGELOG.md)",
      "Read(**/skills.json)",
      "Read(**/package-lock.json)",
      "Read(**/composer.lock)",
      "Read(**/*.lock)"
    ],
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh repo view *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln -s *)",
      "Bash(chmod +x *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(xargs rg *)",
      "Bash(make *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Workflow",
      "Agent",
      "TodoWrite"
    ]
  }
}
