{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:v1:evaluation:case",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evaluation/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "expected_invariants": {
      "type": "array",
      "items": {
        "enum": [
          "tenant_isolation",
          "audience_isolation",
          "permitted_tools_effects",
          "no_duplicates",
          "unknown_not_success",
          "provenance",
          "child_safety_baseline"
        ]
      },
      "minItems": 7,
      "uniqueItems": true,
      "maxItems": 7
    },
    "scorers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scorer_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "hard",
              "domain"
            ]
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "scorer_id",
          "kind",
          "config"
        ]
      },
      "minItems": 1
    },
    "config": {
      "type": "object"
    },
    "evidence_access_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_ref": {
          "type": "string",
          "minLength": 1
        },
        "audience_ref": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "const": "synthetic"
        },
        "allowed_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "personal_data_allowed": {
          "const": false
        }
      },
      "required": [
        "tenant_ref",
        "audience_ref",
        "classification",
        "allowed_evidence_refs",
        "personal_data_allowed"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_provider_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_cost_minor",
        "currency",
        "max_latency_ms",
        "max_provider_calls"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "version",
    "task_ref",
    "profile_ref",
    "input_fixture",
    "expected_invariants",
    "scorers",
    "config",
    "evidence_access_policy",
    "budget"
  ]
}
