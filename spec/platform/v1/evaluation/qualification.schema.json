{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:v1:evaluation:qualification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evaluation/v1"
    },
    "qualification_id": {
      "type": "string",
      "minLength": 1
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_ref": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "profile_bundle_hash": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "suite_hash": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "skills_hash": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "tool_schema_hash": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        },
        "material_corpus_hash": {
          "type": "string",
          "pattern": "^sha-256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "deployment_ref",
        "model_revision",
        "profile_ref",
        "profile_bundle_hash",
        "task_ref",
        "suite_hash",
        "prompt_hash",
        "skills_hash",
        "tool_schema_hash",
        "material_corpus_hash"
      ]
    },
    "required_suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "suite_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "suite_hash": {
            "type": "string",
            "pattern": "^sha-256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "suite_id",
          "version",
          "suite_hash"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha-256:[a-f0-9]{64}$"
      },
      "minItems": 0
    },
    "decision": {
      "enum": [
        "qualified",
        "rejected",
        "insufficient_evidence"
      ]
    },
    "reason": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rollout_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "design-schema",
        "unit",
        "contract-scripted",
        "isolated-postgres",
        "local-host-e2e",
        "live-provider",
        "product-pilot"
      ]
    },
    "readiness_claim": {
      "enum": [
        "technical-contract-only",
        "production"
      ]
    }
  },
  "required": [
    "schema_version",
    "qualification_id",
    "tuple",
    "required_suites",
    "result_refs",
    "decision",
    "reason",
    "issued_at",
    "expires_at",
    "rollout_policy_ref",
    "evidence_kind",
    "readiness_claim"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness_claim": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "product-pilot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "qualified"
          }
        }
      },
      "then": {
        "properties": {
          "result_refs": {
            "minItems": 1
          },
          "reason": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
