{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:v1:evaluation:suite",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evaluation/v1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "case_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "case_hash": {
            "type": "string",
            "pattern": "^sha-256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "case_id",
          "path",
          "case_hash"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_scorers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "corpus_release_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha-256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "ref",
          "sha256"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "integration_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "suite": {
            "type": "string",
            "minLength": 1
          },
          "partition": {
            "enum": [
              "test",
              "pg-test",
              "e2e",
              "check-spec"
            ]
          },
          "required_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source_receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_receipt_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha-256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "suite",
          "partition",
          "required_case_ids",
          "source_receipt_ref",
          "source_receipt_sha256"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "version",
    "case_refs",
    "required_scorers",
    "corpus_release_refs",
    "integration_refs"
  ]
}
