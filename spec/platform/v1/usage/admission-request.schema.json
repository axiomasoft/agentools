{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:admission-request:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_key": {
      "type": "string",
      "minLength": 1
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "turn_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_ref": {
      "type": "string",
      "minLength": 1
    },
    "invocation_ref": {
      "type": "string",
      "minLength": 1
    },
    "business_operation_ref": {
      "type": "string",
      "minLength": 1
    },
    "bundle_ref": {
      "type": "string",
      "minLength": 1
    },
    "deployment_ref": {
      "type": "string",
      "minLength": 1
    },
    "estimated_units": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_uncached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audio_input_units": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "audio_output_units": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "audio_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "request_count",
        "input_uncached_tokens",
        "input_cache_read_tokens",
        "input_cache_write_tokens",
        "output_tokens",
        "reasoning_tokens",
        "audio_input_units",
        "audio_output_units",
        "audio_unit"
      ]
    },
    "pricing_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "desired_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^sha-256:[a-f0-9]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^sha-256:[a-f0-9]{64}$"
    },
    "policy_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "estimated_amount": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "amount",
            "currency"
          ],
          "properties": {
            "kind": {
              "const": "estimate"
            },
            "amount": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      ]
    }
  },
  "required": [
    "operation_key",
    "tenant_ref",
    "actor_ref",
    "subject_ref",
    "purpose",
    "capability",
    "task_type",
    "turn_ref",
    "run_ref",
    "invocation_ref",
    "business_operation_ref",
    "bundle_ref",
    "deployment_ref",
    "estimated_units",
    "pricing_version",
    "desired_deadline",
    "profile_hash",
    "context_hash",
    "policy_versions",
    "estimated_amount"
  ]
}
