{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:usage-event:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1
    },
    "assistant_session_ref": {
      "type": "string",
      "minLength": 1
    },
    "turn_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_ref": {
      "type": "string",
      "minLength": 1
    },
    "business_operation_ref": {
      "type": "string",
      "minLength": 1
    },
    "deployment_ref": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "subject_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "pricing_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "supersedes_event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "schema_version": {
      "const": "1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "agentools.invocation"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "usage_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "producer": {
          "enum": [
            "transport",
            "sdk_hook"
          ]
        },
        "mapping_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "invocation_id",
        "usage_version",
        "producer",
        "mapping_ref"
      ]
    },
    "certainty": {
      "enum": [
        "preliminary",
        "final",
        "partial",
        "unknown"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_uncached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audio_input_units": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "audio_output_units": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "audio_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "request_count",
        "input_uncached_tokens",
        "input_cache_read_tokens",
        "input_cache_write_tokens",
        "output_tokens",
        "reasoning_tokens",
        "audio_input_units",
        "audio_output_units",
        "audio_unit"
      ]
    },
    "provider_amount": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        }
      ]
    },
    "estimate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "kind": {
              "const": "estimate"
            }
          },
          "required": [
            "kind",
            "amount",
            "currency"
          ]
        }
      ]
    }
  },
  "required": [
    "event_id",
    "tenant_ref",
    "assistant_session_ref",
    "turn_ref",
    "run_ref",
    "business_operation_ref",
    "deployment_ref",
    "correlation_id",
    "actor_ref",
    "subject_ref",
    "model_revision",
    "pricing_version",
    "supersedes_event_id",
    "schema_version",
    "source",
    "certainty",
    "occurred_at",
    "units",
    "provider_amount",
    "estimate"
  ]
}
