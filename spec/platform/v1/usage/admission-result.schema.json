{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentools:platform:admission-result:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "admitted",
        "denied",
        "unavailable",
        "unknown",
        "not_found"
      ]
    },
    "admission_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reservation_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "owner_revision": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retry_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "status",
    "admission_ref",
    "reservation_ref",
    "expires_at",
    "owner_revision",
    "limits",
    "reason",
    "retry_after"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "admission_ref": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "owner_revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "denied",
              "unavailable",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
