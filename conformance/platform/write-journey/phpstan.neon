parameters:
    level: max
    bootstrapFiles:
        - bootstrap.php
    paths:
        - BoundaryJournal.php
        - Journey.php
        - Ports.php
        - PortableReference.php
        - RecoveryTest.php
        - Report.php
        - WriteJourneyTest.php
        - worker.php
        - reference.php
