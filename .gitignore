/php/var/*.sqlite
/php/var/*.sqlite-*
/conformance/vendor/
/out/
/conformance/mcp/node_modules/
/.ci/cache/
__pycache__/
*.py[cod]
*.log
.DS_Store
.mcp.json
.mcp.json.bak

# Machine-specific ecosystem (mAInd / swissknifeman) — do not commit
.cursor/mcp.json
.cursor/mcp.json.bak
