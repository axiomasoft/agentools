{
  "name": "agentools/sdk",
  "description": "PHP contracts and validators for the AgenTools protocol.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "mmccook/php-json-canonicalization-scheme": "^1.0",
    "opis/json-schema": "^2.6",
    "php": ">=8.3",
    "symfony/uid": "^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "psr-4": {
      "AgenTools\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgenTools\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse -c phpstan.neon --no-progress",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "agentools": {
      "spec_rev": "2026-08"
    }
  },
  "minimum-stability": "stable"
}
