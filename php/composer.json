{
  "name": "agentools/sdk",
  "description": "PHP contracts and validators for the AgenTools protocol.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "mmccook/php-json-canonicalization-scheme": "^1.0",
    "opis/json-schema": "^2.6",
    "php": ">=8.3",
    "symfony/uid": "^7.4"
  },
  "require-dev": {
    "infection/infection": "^0.35.4",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "psr-4": {
      "AgenTools\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgenTools\\Reference\\": "reference/",
      "AgenTools\\TestKit\\": "testkit/",
      "AgenTools\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/conformance",
      "/reference",
      "/testkit",
      "/tests",
      "/vendor",
      "/tmp",
      "/.cursor",
      "/.phpunit.result.cache"
    ]
  },
  "scripts": {
    "analyse": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
    "test": "phpunit",
    "infection": "infection --threads=max --ignore-msi-with-no-mutations"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "suggest": {
    "ext-pdo_pgsql": "Required for PdoPostgresConfirmationTokenStore, PdoPostgresIdempotencyStore and PdoPostgresEventStore"
  },
  "extra": {
    "agentools": {
      "spec_rev": "2026-09",
      "declared_level": "L3"
    }
  },
  "minimum-stability": "stable"
}
