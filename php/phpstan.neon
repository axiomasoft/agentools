parameters:
    level: max
    paths:
        - src
        - testkit
        - reference
        - tests
    scanDirectories:
        - ../packages/agentools-core/src
    scanFiles:
        - ../packages/agentools-core/tests/Common/Harness.php
        - conformance/HarnessToolPort.php
    excludePaths:
        - reference/conformance/adapter.php
        - tests/Adversarial/storage_worker.php
